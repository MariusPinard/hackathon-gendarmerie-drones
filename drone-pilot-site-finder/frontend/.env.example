# Defaults work without this file. Copy to .env.local to override.
API_PROXY_TARGET=http://127.0.0.1:8000
# Empty means same-origin /api via Vite's development/preview proxy.
VITE_API_BASE_URL=
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Set false for offline UI/API testing (plain grid, no map tile requests).
VITE_TILES_ENABLED=true
